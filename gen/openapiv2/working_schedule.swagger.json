          },
          {
            "name": "agentId",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "WorkingScheduleService"
        ]
      }
    },
    "/wfm/lookups/working_schedules/{id}/block_outside_activity": {
      "patch": {
        "summary": "Switches blocking outside a shift on or off in a draft, pending or active schedule, with the\netag from a read; the response carries the schedule with the new etag. After creation it is\nthe only way to change it. Switched on in an active schedule, it also takes agents who are\nonline outside their shift offline.",
        "description": "Refusals: storage.working_schedule.archived; storage.working_schedule.version_conflict\n(409) - the header changed since the read.",
        "operationId": "WorkingScheduleService_UpdateWorkingScheduleBlockOutsideActivity",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/wfmUpdateWorkingScheduleBlockOutsideActivityResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "blockOutsideActivity": {
                  "type": "boolean"
                },
                "etag": {
                  "type": "string",
                  "description": "The etag from a read."
                }
              }
            }
          }
        ],
        "tags": [
          "WorkingScheduleService"
        ]
      }
    },
    "/wfm/lookups/working_schedules/{id}/forecast": {
      "get": {
        "summary": "How many agents each hour of a period needs, from the forecast procedure of the team. The\nprocedure runs on every call and nothing is stored, so edits of the schedule do not change\nthe result. A team without a forecast calculation gets no hours.",
        "operationId": "WorkingScheduleService_ReadWorkingScheduleForecast",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/wfmReadWorkingScheduleForecastResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "date.from",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "date.to",
            "description": "The last day, included.",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "WorkingScheduleService"
        ]
      }
    },
    "/wfm/lookups/working_schedules/{id}/planned": {
      "get": {
        "summary": "How many agents are on a shift and not on a pause, per 15 minutes and per day. It reads\nonly the schedule, so every edit of it changes the result.",
        "operationId": "WorkingScheduleService_ReadWorkingSchedulePlanned",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/wfmReadWorkingSchedulePlannedResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "date.from",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "date.to",
            "description": "The last day, included.",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "WorkingScheduleService"
        ]
      }
    },
    "/wfm/lookups/working_schedules/{id}/state": {
      "patch": {
        "summary": "Moves the schedule to another state, in any order but out of archived, with the etag from\na read; the response carries the schedule with the new etag.",
        "description": "Moving to pending or active needs an answer about unplanned days: dates of the period where\nan agent of the schedule has neither a shift nor an absence. Without fill_days_off the call\nrefuses with service.working_schedule.unplanned_days. The days off are written in the same\ntransaction, as absences.\n\nMoving to active first checks the rules and refuses with\nstorage.working_schedule.activation_refused and violations:\nstorage.working_schedule.team_active - the team has another active schedule on overlapping\ndates; storage.shift.locked_date or storage.shift.overlap - an agent works in another active\nschedule on the same date or at the same time. storage.working_schedule.version_conflict\n(409) - the header changed since the read.",
        "operationId": "WorkingScheduleService_UpdateWorkingScheduleState",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/wfmUpdateWorkingScheduleStateResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "state": {
                  "$ref": "#/definitions/wfmWorkingScheduleState"
                },
                "etag": {
                  "type": "string",
                  "description": "The etag from a read."
                },
                "fillDaysOff": {
                  "type": "boolean",
                  "description": "The answer about unplanned days: true fills them with days off, holidays and the calendar's\ndays off included; false leaves them empty. Absent, the call refuses if there are any."
                }
              }
            }
          }
        ],
        "tags": [
          "WorkingScheduleService"
        ]
      }
    },
    "/wfm/lookups/working_schedules/{item.id}": {
      "put": {
        "summary": "Updates the header of a draft schedule, with the etag from a read; the response carries the\nnew etag. A change of the team rebuilds the schedule: every shift is deleted and the agents\nbecome the new team's agents the user has access to, so agents added by hand leave too. A\nchange of the calendar deletes every shift; a change of the dates deletes the shifts whose\nworking date falls outside the new period. The time scale, the name and Special time skills\nkeep the shifts. block_outside_activity is ignored: only\nUpdateWorkingScheduleBlockOutsideActivity changes it.",
        "description": "Refusals: service.working_schedule.state - not a draft;\nstorage.working_schedule.version_conflict (409) - the header changed since the read.",
        "operationId": "WorkingScheduleService_UpdateWorkingSchedule",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/wfmUpdateWorkingScheduleResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "item.id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "item": {
                  "type": "object",
                  "properties": {
                    "domainId": {
                      "type": "string",
                      "format": "int64"
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "int64"
                    },
                    "createdBy": {
                      "$ref": "#/definitions/wfmLookupEntity"
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "int64"
                    },
                    "updatedBy": {
                      "$ref": "#/definitions/wfmLookupEntity"
                    },
                    "name": {
                      "type": "string"
                    },
                    "state": {
                      "$ref": "#/definitions/wfmWorkingScheduleState",
                      "description": "Set by the server: a new schedule is a draft, and only UpdateWorkingScheduleState changes it."
                    },
                    "team": {
                      "$ref": "#/definitions/wfmLookupEntity"
                    },
                    "calendar": {
                      "$ref": "#/definitions/wfmLookupEntity"
                    },
                    "startDateAt": {
                      "type": "string",
                      "format": "int64",
                      "description": "The first and the last day of the schedule, dates as in DateRange: 00:00 UTC of the\nday, epoch milliseconds."
                    },
                    "endDateAt": {
                      "type": "string",
                      "format": "int64"
                    },
                    "startTimeAt": {
                      "type": "string",
                      "format": "int64",
                      "description": "The time scale of the schedule, minutes from midnight in the zone of its calendar. Both\nabsent mean 24 hours; an end before the start crosses midnight. It does not limit shifts."
                    },
                    "endTimeAt": {
                      "type": "string",
                      "format": "int64"
                    },
                    "extraSkills": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "$ref": "#/definitions/wfmLookupEntity"
                      },
                      "description": "Special time skills; the shape may change to a skill group."
                    },
                    "blockOutsideActivity": {
                      "type": "boolean",
                      "description": "Off by default. Set on creation; afterwards only UpdateWorkingScheduleBlockOutsideActivity\nchanges it."
                    },
                    "agents": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "$ref": "#/definitions/wfmLookupEntity"
                      }
                    },
                    "totalAgents": {
                      "type": "string",
                      "format": "int64"
                    },
                    "etag": {
                      "type": "string",
                      "description": "Version of the row, returned by every read. UpdateWorkingSchedule, UpdateWorkingScheduleState\nand UpdateWorkingScheduleBlockOutsideActivity require it and refuse with\nstorage.working_schedule.version_conflict (409) when the schedule has changed since."
                    }
                  }
                }
              }
            }
          }
        ],
        "tags": [
          "WorkingScheduleService"
        ]
      }
    }
  },
