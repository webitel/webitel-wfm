        ]
      }
    },
    "/wfm/lookups/working_schedules/{id}/agents": {
      "post": {
        "summary": "Adds agents from any team, each once: an agent already in the schedule is skipped. The\nresponse lists the added ones, with names.",
        "operationId": "WorkingScheduleService_UpdateWorkingScheduleAddAgents",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/wfmUpdateWorkingScheduleAddAgentsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "agents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "$ref": "#/definitions/wfmLookupEntity"
                  }
                }
              }
            }
          }
        ],
        "tags": [
          "WorkingScheduleService"
        ]
      }
    },
    "/wfm/lookups/working_schedules/{id}/agents/{agentId}": {
      "delete": {
        "summary": "Removes an agent with their shifts in this schedule; absences stay.",
        "operationId": "WorkingScheduleService_UpdateWorkingScheduleRemoveAgent",
        "responses": {
          "200": {
