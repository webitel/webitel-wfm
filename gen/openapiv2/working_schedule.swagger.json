          "items": {
            "type": "object",
            "$ref": "#/definitions/wfmLookupEntity"
          },
          "description": "Special time skills; the shape may change to a skill group."
        },
        "blockOutsideActivity": {
          "type": "boolean",
          "description": "Off by default. Set on creation; afterwards only UpdateWorkingScheduleBlockOutsideActivity\nchanges it."
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/wfmLookupEntity"
          }
        },
        "totalAgents": {
          "type": "string",
          "format": "int64"
        },
        "etag": {
          "type": "string",
          "description": "Version of the row, returned by every read. UpdateWorkingSchedule, UpdateWorkingScheduleState\nand UpdateWorkingScheduleBlockOutsideActivity require it and refuse with\nstorage.working_schedule.version_conflict (409) when the schedule has changed since."
        }
      }
    },
    "wfmWorkingScheduleState": {
      "type": "string",
      "enum": [
        "WORKING_SCHEDULE_STATE_UNSPECIFIED",
        "WORKING_SCHEDULE_STATE_DRAFT",
        "WORKING_SCHEDULE_STATE_PENDING",
        "WORKING_SCHEDULE_STATE_ACTIVE",
        "WORKING_SCHEDULE_STATE_ARCHIVED"
      ],
      "default": "WORKING_SCHEDULE_STATE_UNSPECIFIED"
    }
  }
}
