        ]
      },
      "delete": {
        "summary": "Deletes the schedule with its shifts, pauses and skills; absences stay. An active schedule\nrefuses with storage.working_schedule.active until its state changes.",
        "operationId": "WorkingScheduleService_DeleteWorkingSchedule",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/wfmDeleteWorkingScheduleResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
