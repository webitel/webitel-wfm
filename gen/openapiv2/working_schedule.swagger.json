  "paths": {
    "/wfm/lookups/working_schedules": {
      "get": {
        "summary": "Searches schedules, each with its number of agents.",
        "operationId": "WorkingScheduleService_SearchWorkingSchedule",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/wfmSearchWorkingScheduleResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "sort",
            "description": "States sort as active, pending, draft, archived.",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "fields",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          }
        ],
        "tags": [
          "WorkingScheduleService"
        ]
      },
      "post": {
        "summary": "A new schedule is always a draft, whatever state the request carries. It gets every agent\nof the team the user has access to; agents who join the team later are added by hand.",
        "operationId": "WorkingScheduleService_CreateWorkingSchedule",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/wfmCreateWorkingScheduleResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/wfmCreateWorkingScheduleRequest"
            }
          }
        ],
        "tags": [
          "WorkingScheduleService"
        ]
      }
    },
