  "paths": {
    "/wfm/agents/working_schedules/{workingScheduleId}": {
      "get": {
        "summary": "A page of the schedule's agents with their days, and the holidays and working week of the\nschedule's calendar.",
        "operationId": "AgentWorkingScheduleService_SearchAgentsWorkingSchedule",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/wfmSearchAgentsWorkingScheduleResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "workingScheduleId",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "date.from",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "date.to",
            "description": "The last day, included.",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "supervisorId",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "format": "int64"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "teamId",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "format": "int64"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "skillId",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "format": "int64"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "page",
            "description": "A page of agents, ordered by name and then by id; the filters apply first.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "AgentWorkingScheduleService"
        ]
      },
      "post": {
        "summary": "Expands a weekly template into shifts for several agents over a range of dates. Days with\nan absence and days another active schedule locks are skipped and returned in skipped; the\nrest is written.",
        "description": "Refusals of the whole request: storage.shift.refused with violations - a shift overlaps\nanother shift of the agent, or the agent or the date is not of this schedule;\nstorage.working_schedule.archived; service.request.too_large - more than the limit, sized for\na team of 200 agents over a month.",
        "operationId": "AgentWorkingScheduleService_CreateAgentsWorkingScheduleShifts",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/wfmCreateAgentsWorkingScheduleShiftsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "workingScheduleId",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "date": {
                  "$ref": "#/definitions/wfmDateRange",
                  "description": "Both ends included."
                },
                "agents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "$ref": "#/definitions/wfmLookupEntity"
                  }
                },
                "days": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/definitions/wfmShiftTemplateDay"
                  },
                  "description": "Map key is a day of week: 0 - Sunday, ..., 6 - Saturday. A day missing from the map gets\nno shifts."
                },
                "pauses": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "$ref": "#/definitions/wfmShiftTemplatePause"
                  },
                  "description": "Pauses of every day. Each belongs to the range that contains it; a pause outside\nevery range of a day refuses the request."
                },
                "skills": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "$ref": "#/definitions/wfmAgentScheduleShiftSkill"
                  },
                  "description": "Skills switched on for the time of every shift the request creates. Different\nskills for different ranges take separate requests."
                }
              },
              "description": "A weekly template the server expands into shifts over a range of dates. Hours are\nwall-clock minutes from midnight in the time zone of the schedule's calendar, so a shift\nkeeps its hours across a daylight saving change."
            }
          }
        ],
        "tags": [
          "AgentWorkingScheduleService"
        ]
      }
    },
    "/wfm/agents/working_schedules/{workingScheduleId}/shifts/{id}": {
      "delete": {
        "summary": "Deletes a shift with its pauses and skills. Refusals as in UpdateAgentWorkingScheduleShift,\nexcept the shift rules.",
        "operationId": "AgentWorkingScheduleService_DeleteAgentWorkingScheduleShift",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/wfmDeleteAgentWorkingScheduleShiftResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "workingScheduleId",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "etag",
            "description": "The etag from a read.",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "AgentWorkingScheduleService"
        ]
      }
    },
    "/wfm/agents/working_schedules/{workingScheduleId}/shifts/{shift.id}": {
      "put": {
        "summary": "Replaces one shift whole: its time, and the pauses and skills of the request replace the\nexisting ones, so a pause is deleted by sending the shift without it. Needs the etag from a\nread; the response carries the shift with the new etag. Allowed in a draft, pending or\nactive schedule.",
        "description": "Refusals: storage.shift.version_conflict (409) - the shift changed since the read;\nstorage.shift.refused with violations - the rules of CreateAgentsWorkingScheduleShifts, plus\nan absence or a locked date; storage.working_schedule.archived; dbsql.query.no_rows (404) -\nthe shift is gone.",
        "operationId": "AgentWorkingScheduleService_UpdateAgentWorkingScheduleShift",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/wfmUpdateAgentWorkingScheduleShiftResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "workingScheduleId",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "shift.id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "shift": {
                  "type": "object",
                  "properties": {
                    "domainId": {
                      "type": "string",
                      "format": "int64"
                    },
                    "createdAt": {
                      "type": "string",
                      "format": "int64"
                    },
                    "createdBy": {
                      "$ref": "#/definitions/wfmLookupEntity"
                    },
                    "updatedAt": {
                      "type": "string",
                      "format": "int64"
                    },
                    "updatedBy": {
                      "$ref": "#/definitions/wfmLookupEntity"
                    },
                    "startAt": {
                      "type": "string",
                      "format": "int64",
                      "description": "Epoch milliseconds. The shift ends right before end_at, so the next one can start at end_at."
                    },
                    "endAt": {
                      "type": "string",
                      "format": "int64"
                    },
                    "pauses": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "$ref": "#/definitions/wfmAgentScheduleShiftPause"
                      }
                    },
                    "skills": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "$ref": "#/definitions/wfmAgentScheduleShiftSkill"
                      }
                    },
                    "workingDate": {
                      "type": "string",
                      "format": "int64",
                      "description": "Set by the server. The working date, a date as in DateRange: the day the shift starts\non in the time zone of the schedule's calendar, so a night shift belongs to the day it\nstarts. 00:00 UTC of that day, epoch milliseconds."
                    },
                    "etag": {
                      "type": "string",
                      "description": "Version of the shift, returned by every read. Editing and deleting a shift require it."
                    },
                    "source": {
                      "$ref": "#/definitions/wfmShiftSource",
                      "description": "Set by the server."
                    },
                    "plannerRunId": {
                      "type": "string",
                      "format": "int64",
                      "description": "Set by the server for a planner's shift: the planning run that wrote it."
                    }
                  },
                  "description": "The shift with its id and the etag from a read. start_at, end_at, pauses and skills are\nwritten; the server sets the rest.",
                  "title": "The shift with its id and the etag from a read. start_at, end_at, pauses and skills are\nwritten; the server sets the rest."
                }
              }
            }
          }
        ],
        "tags": [
          "AgentWorkingScheduleService"
        ]
      }
    }
  },
