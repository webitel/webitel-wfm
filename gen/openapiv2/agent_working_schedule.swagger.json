          "additionalProperties": {
            "$ref": "#/definitions/wfmCalendarDay"
          },
          "description": "Map key is a day of week as in the Add shifts template: 0 - Sunday, ..., 6 - Saturday.\nEvery day is present; a day without ranges is a day off."
        }
      }
    },
    "wfmSearchAgentsWorkingScheduleResponse": {
      "type": "object",
      "properties": {
        "holidays": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/wfmHoliday"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/wfmAgentWorkingSchedule"
          }
        },
        "total": {
          "type": "string",
          "format": "int64",
          "description": "Agents that match the filters, on all pages; 0 on a page past the last one."
        },
        "next": {
          "type": "boolean"
        },
        "calendar": {
          "$ref": "#/definitions/wfmScheduleCalendar",
          "description": "The calendar of the schedule, to tell working days from days off and to show\ntimes in its zone."
        }
      }
    },
    "wfmShiftSource": {
      "type": "string",
      "enum": [
        "SHIFT_SOURCE_UNSPECIFIED",
        "SHIFT_SOURCE_MANUAL",
        "SHIFT_SOURCE_PLANNER"
      ],
      "default": "SHIFT_SOURCE_UNSPECIFIED"
    },
    "wfmShiftTemplateDay": {
      "type": "object",
      "properties": {
        "ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/wfmShiftTemplateRange"
          }
        }
      },
      "description": "ShiftTemplateDay holds the shifts of one day of week, several when the agent works\non different skills at different hours."
    },
    "wfmShiftTemplatePause": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "format": "int32",
          "description": "Minutes from midnight."
        },
        "duration": {
          "type": "integer",
          "format": "int32",
          "description": "Minutes."
        },
        "cause": {
          "$ref": "#/definitions/wfmLookupEntity"
        }
      },
      "description": "ShiftTemplatePause is a pause of every day at a wall-clock time. In a range that\ncrosses midnight, a pause after 00:00 belongs to the shift of the previous day."
    },
    "wfmShiftTemplateRange": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "format": "int32"
        },
        "end": {
          "type": "integer",
          "format": "int32"
        }
      },
      "description": "ShiftTemplateRange is one shift of a day, in minutes from midnight. An end before the\nstart crosses midnight: 1320 to 360 is 22:00 to 06:00, a shift of the day it starts on."
    },
    "wfmUpdateAgentWorkingScheduleShiftResponse": {
      "type": "object",
      "properties": {
        "shift": {
          "$ref": "#/definitions/wfmAgentScheduleShift"
        }
      }
    },
    "wfmViolation": {
      "type": "object",
      "properties": {
        "agent": {
          "$ref": "#/definitions/wfmLookupEntity",
          "description": "Absent when the rule is about the schedule as a whole."
        },
        "date": {
          "type": "string",
          "format": "int64",
          "description": "A date as in DateRange: 00:00 UTC of the day, epoch milliseconds. Absent when the rule is\nabout the schedule as a whole."
        },
        "reason": {
          "type": "string",
          "description": "The reason id, \u003clayer\u003e.\u003centity\u003e.\u003cwhat\u003e."
        },
        "schedule": {
          "$ref": "#/definitions/wfmLookupEntity",
          "description": "The other schedule the rule is about, if any."
        },
        "shiftId": {
          "type": "string",
          "format": "int64",
          "description": "The existing shift the rule is about, if any: the one an absence deletes, or the one a new\nshift overlaps. Absent when the overlap is between two new shifts of the same request."
        },
        "startAt": {
          "type": "string",
          "format": "int64",
          "description": "Start and end of that shift, epoch milliseconds."
        },
        "endAt": {
          "type": "string",
          "format": "int64"
        }
      },
      "description": "A WFM error has the body {\"id\", \"code\", \"status\", \"detail\"}. Errors are told apart by id, not\nby HTTP status: 400 is both a validation error and a business refusal, 409 both a version\nconflict and a duplicate. detail is a fallback text for people; a refusal with violations\nputs JSON there instead: {\"text\": \"...\", \"violations\": [Violation, ...]}, with the field names\nof this API.\n\nCommon to every WFM method: interceptor.validate (400) - an invalid request;\ninterceptor.auth.license and interceptor.auth.permission (403) - no WFM license or no right on\nthe object class; service.agent.access (403) - no access to the agent, never 404;\ndbsql.query.no_rows (404) - the record is gone; storage.working_schedule.archived (400) - a\nwrite to an archived schedule, which is read-only. After a version conflict (409) the record\nhas to be read again.",
      "title": "Violation is one broken rule: which agent, on which date, why, and which other schedule\nor shift is in the way. A refusal lists the rules it broke; reasons are told apart by id:\n  storage.shift.agent_not_in_schedule - the agent is not in the schedule\n  storage.shift.agent_deactivated - the agent's user is deactivated\n  storage.shift.outside_schedule - the date is outside the schedule's period\n  storage.shift.absence - the agent has an absence on the date\n  storage.shift.locked_date - the agent has shifts in another active schedule on the date\n  storage.shift.overlap - the shift overlaps another shift of the agent, a night one included\n  storage.absence.shift - the agent has a shift on the date in a draft, pending or active\n    schedule, which the absence deletes once confirmed\n  storage.working_schedule.team_active - the team already has an active schedule on\n    overlapping dates; no agent or date"
    }
  }
