      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/wfmAgentWorkingSchedule"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/wfmViolation"
          },
          "description": "Days the request left without shifts, and why: storage.shift.absence, or\nstorage.shift.locked_date with the schedule that holds the date."
        }
      }
    },
    "wfmDateRange": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "int64"
        },
        "to": {
          "type": "string",
          "format": "int64",
          "description": "The last day, included."
        }
      },
      "description": "DateRange is an inclusive range of calendar dates. A date anywhere in WFM is a day, not\nan instant: 00:00 UTC of that day in epoch milliseconds, the same for every client\nwhatever its time zone. Any other value is refused, so a local midnight shows up as\nan error instead of a day shifted by the client's offset."
    },
    "wfmDeleteAgentWorkingScheduleShiftResponse": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "int64"
        }
