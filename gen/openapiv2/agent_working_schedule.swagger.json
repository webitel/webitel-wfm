{
  "swagger": "2.0",
  "info": {
    "title": "agent_working_schedule.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "AgentWorkingScheduleService"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/wfm/agents/working_schedules/{workingScheduleId}": {
      "get": {
        "operationId": "AgentWorkingScheduleService_SearchAgentsWorkingSchedule",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/wfmSearchAgentsWorkingScheduleResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "workingScheduleId",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "date.from",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "date.to",
            "description": "The last day, included.",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "supervisorId",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "format": "int64"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "teamId",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "format": "int64"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "skillId",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "format": "int64"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "page",
            "description": "A page of agents, ordered by name and then by id; the filters apply first.",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "AgentWorkingScheduleService"
        ]
      },
      "post": {
        "operationId": "AgentWorkingScheduleService_CreateAgentsWorkingScheduleShifts",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/wfmCreateAgentsWorkingScheduleShiftsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "workingScheduleId",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "date": {
                  "$ref": "#/definitions/wfmDateRange",
                  "description": "Date from and Date to of the modal."
                },
                "agents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "$ref": "#/definitions/wfmLookupEntity"
                  }
                },
                "days": {
                  "type": "object",
                  "additionalProperties": {
                    "$ref": "#/definitions/wfmShiftTemplateDay"
                  },
                  "description": "Map key is a day of week: 0 - Sunday, ..., 6 - Saturday. A day missing from the\nmap, one switched off in the modal, gets no shifts."
                },
                "pauses": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "$ref": "#/definitions/wfmShiftTemplatePause"
                  },
                  "description": "Pauses of every day. Each belongs to the range that contains it; a pause outside\nevery range of a day refuses the request."
                },
                "skills": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "$ref": "#/definitions/wfmAgentScheduleShiftSkill"
                  },
                  "description": "Skills switched on for the time of every shift the request creates. Different\nskills for different ranges take separate requests."
                }
              },
              "description": "The Add shifts modal: a weekly template the server expands into shifts over a range\nof dates (WFM-103). Hours are wall-clock minutes from midnight in the time zone of\nthe schedule's calendar, so a shift keeps its hours across a daylight saving change."
            }
          }
        ],
        "tags": [
          "AgentWorkingScheduleService"
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "wfmAbsenceType": {
      "type": "string",
      "enum": [
        "ABSENCE_TYPE_UNSPECIFIED",
        "ABSENCE_TYPE_DAYOFF",
        "ABSENCE_TYPE_VACATION",
        "ABSENCE_TYPE_SICKDAY"
      ],
      "default": "ABSENCE_TYPE_UNSPECIFIED"
    },
    "wfmAgentSchedule": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "format": "int64",
          "description": "The working date, a date as in DateRange: 00:00 UTC of the day, epoch milliseconds."
        },
        "locked": {
          "type": "boolean"
        },
        "absence": {
          "$ref": "#/definitions/wfmAbsenceType",
          "description": "A day has an absence or shifts, not both."
        },
        "shifts": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/wfmAgentScheduleShift"
          }
        }
      }
    },
    "wfmAgentScheduleShift": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "int64"
        },
        "domainId": {
          "type": "string",
          "format": "int64"
        },
        "createdAt": {
          "type": "string",
          "format": "int64"
        },
        "createdBy": {
          "$ref": "#/definitions/wfmLookupEntity"
        },
        "updatedAt": {
          "type": "string",
          "format": "int64"
        },
        "updatedBy": {
          "$ref": "#/definitions/wfmLookupEntity"
        },
        "startAt": {
          "type": "string",
          "format": "int64",
          "description": "Epoch milliseconds. The shift ends right before end_at, so the next one can start at end_at."
        },
        "endAt": {
          "type": "string",
          "format": "int64"
        },
        "pauses": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/wfmAgentScheduleShiftPause"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/wfmAgentScheduleShiftSkill"
          }
        },
        "workingDate": {
          "type": "string",
          "format": "int64",
          "description": "Set by the server. The working date, a date as in DateRange: the day the shift starts\non in the time zone of the schedule's calendar, so a night shift belongs to the day it\nstarts. 00:00 UTC of that day, epoch milliseconds."
        },
        "etag": {
          "type": "string",
          "description": "Version of the shift, returned by every read. Editing a shift requires it (WFM-99)."
        },
        "source": {
          "$ref": "#/definitions/wfmShiftSource",
          "description": "Set by the server."
        },
        "plannerRunId": {
          "type": "string",
          "format": "int64",
          "description": "Set by the server for a planner's shift: the planning run that wrote it."
        }
      }
    },
    "wfmAgentScheduleShiftPause": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "int64"
        },
        "domainId": {
          "type": "string",
          "format": "int64"
        },
        "createdAt": {
          "type": "string",
          "format": "int64"
        },
        "createdBy": {
          "$ref": "#/definitions/wfmLookupEntity"
        },
        "updatedAt": {
          "type": "string",
          "format": "int64"
        },
        "updatedBy": {
          "$ref": "#/definitions/wfmLookupEntity"
        },
        "startAt": {
          "type": "string",
          "format": "int64",
          "description": "Epoch milliseconds, inside the shift."
        },
        "endAt": {
          "type": "string",
          "format": "int64"
        },
        "cause": {
          "$ref": "#/definitions/wfmLookupEntity"
        }
      }
    },
    "wfmAgentScheduleShiftSkill": {
      "type": "object",
      "properties": {
        "skill": {
          "$ref": "#/definitions/wfmLookupEntity"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "description": "AgentScheduleShiftSkill switches a skill the agent already has on or off for the time\nof the shift, with the agent's own capacity (WFM-114)."
    },
    "wfmAgentWorkingSchedule": {
      "type": "object",
      "properties": {
        "agent": {
          "$ref": "#/definitions/wfmLookupEntity"
        },
        "schedule": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/wfmAgentSchedule"
          }
        }
      }
    },
    "wfmCalendarDay": {
      "type": "object",
      "properties": {
        "ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/wfmCalendarRange"
          },
          "description": "Working hours, wall-clock minutes from midnight in the calendar's zone."
        }
      }
    },
    "wfmCalendarRange": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "format": "int32"
        },
        "end": {
          "type": "integer",
          "format": "int32"
        }
      }
    },
    "wfmCreateAgentsWorkingScheduleShiftsResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/wfmAgentWorkingSchedule"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/wfmSkippedDay"
          },
          "description": "Days the request left without shifts, and why: an absence, or a date another\nactive schedule locks (WFM-103)."
        }
      }
    },
    "wfmDateRange": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "int64"
        },
        "to": {
          "type": "string",
          "format": "int64",
          "description": "The last day, included."
        }
      },
      "description": "DateRange is an inclusive range of calendar dates. A date anywhere in WFM is a day, not\nan instant: 00:00 UTC of that day in epoch milliseconds, the same for every client\nwhatever its time zone. Any other value is refused, so a local midnight shows up as\nan error instead of a day shifted by the client's offset."
    },
    "wfmHoliday": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "format": "int64",
          "description": "A date as in DateRange: 00:00 UTC of the day, epoch milliseconds."
        },
        "name": {
          "type": "string"
        }
      }
    },
    "wfmLookupEntity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "int64"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "wfmScheduleCalendar": {
      "type": "object",
      "properties": {
        "timeZone": {
          "type": "string",
          "description": "IANA name, such as \"Europe/Kyiv\"."
        },
        "week": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/wfmCalendarDay"
          },
          "description": "Map key is a day of week as in the Add shifts template: 0 - Sunday, ..., 6 - Saturday.\nEvery day is present; a day without ranges is a day off."
        }
      }
    },
    "wfmSearchAgentsWorkingScheduleResponse": {
      "type": "object",
      "properties": {
        "holidays": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/wfmHoliday"
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/wfmAgentWorkingSchedule"
          }
        },
        "total": {
          "type": "string",
          "format": "int64",
          "description": "Agents that match the filters, on all pages; 0 on a page past the last one."
        },
        "next": {
          "type": "boolean"
        },
        "calendar": {
          "$ref": "#/definitions/wfmScheduleCalendar",
          "description": "The calendar of the schedule, to tell working days from days off and to show\ntimes in its zone."
        }
      }
    },
    "wfmShiftSource": {
      "type": "string",
      "enum": [
        "SHIFT_SOURCE_UNSPECIFIED",
        "SHIFT_SOURCE_MANUAL",
        "SHIFT_SOURCE_PLANNER"
      ],
      "default": "SHIFT_SOURCE_UNSPECIFIED"
    },
    "wfmShiftTemplateDay": {
      "type": "object",
      "properties": {
        "ranges": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/wfmShiftTemplateRange"
          }
        }
      },
      "description": "ShiftTemplateDay holds the shifts of one day of week, several when the agent works\non different skills at different hours."
    },
    "wfmShiftTemplatePause": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "format": "int32",
          "description": "Minutes from midnight."
        },
        "duration": {
          "type": "integer",
          "format": "int32",
          "description": "Minutes."
        },
        "cause": {
          "$ref": "#/definitions/wfmLookupEntity"
        }
      },
      "description": "ShiftTemplatePause is a pause of every day at a wall-clock time. In a range that\ncrosses midnight, a pause after 00:00 belongs to the shift of the previous day."
    },
    "wfmShiftTemplateRange": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "format": "int32"
        },
        "end": {
          "type": "integer",
          "format": "int32"
        }
      },
      "description": "ShiftTemplateRange is one shift of a day, in minutes from midnight. An end before the\nstart crosses midnight: 1320 to 360 is 22:00 to 06:00, a shift of the day it starts on."
    },
    "wfmSkippedDay": {
      "type": "object",
      "properties": {
        "agent": {
          "$ref": "#/definitions/wfmLookupEntity"
        },
        "date": {
          "type": "string",
          "format": "int64",
          "description": "A date as in DateRange: 00:00 UTC of the day, epoch milliseconds."
        },
        "reason": {
          "type": "string",
          "description": "An error id, \u003clayer\u003e.\u003centity\u003e.\u003cwhat\u003e."
        }
      }
    }
  }
}
